{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "authorisation.schema.json",
  "title": "Authorisation",
  "description": "A payment request under a mandate, and the trust layer's decision on it.",
  "version": "0.1.0",
  "type": "object",
  "required": ["request"],
  "properties": {
    "request": {
      "type": "object",
      "required": ["requestId", "mandateId", "agentId", "merchantId", "offerId", "amount", "currency", "productCategory", "createdAt"],
      "properties": {
        "requestId": { "type": "string" },
        "mandateId": { "type": "string" },
        "agentId": { "type": "string" },
        "merchantId": { "type": "string" },
        "offerId": { "type": "string" },
        "amount": { "type": "integer", "minimum": 1, "description": "In cents." },
        "currency": { "type": "string", "const": "EUR" },
        "productCategory": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "decision": {
      "type": "object",
      "required": ["requestId", "outcome", "decidedAt"],
      "properties": {
        "requestId": { "type": "string" },
        "outcome": { "type": "string", "enum": ["approved", "refused"] },
        "reason": {
          "type": "string",
          "enum": ["mandate_not_found", "mandate_inactive", "agent_mismatch", "merchant_out_of_scope", "category_out_of_scope", "amount_over_transaction_limit", "amount_over_period_limit", "too_many_transactions"]
        },
        "authorisationToken": { "type": "string", "description": "Present when approved; the wallet requires it to settle." },
        "decidedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}

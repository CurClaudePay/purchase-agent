{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mandate.schema.json",
  "title": "Mandate",
  "description": "Consumer-approved permission for an agent to make purchases within limits.",
  "version": "0.1.0",
  "type": "object",
  "required": ["mandateId", "consumerId", "agentId", "scope", "limits", "validFrom", "validUntil", "status"],
  "properties": {
    "mandateId": { "type": "string" },
    "consumerId": { "type": "string" },
    "agentId": { "type": "string" },
    "scope": {
      "type": "object",
      "required": ["merchantIds", "productCategories"],
      "properties": {
        "merchantIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "productCategories": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "limits": {
      "type": "object",
      "required": ["currency", "maxAmountPerTransaction", "maxAmountPerPeriod", "period"],
      "properties": {
        "currency": { "type": "string", "const": "EUR" },
        "maxAmountPerTransaction": { "type": "integer", "minimum": 0, "description": "In cents." },
        "maxAmountPerPeriod": { "type": "integer", "minimum": 0, "description": "In cents." },
        "period": { "type": "string", "enum": ["day", "week", "month"] },
        "maxTransactionsPerPeriod": { "type": "integer", "minimum": 1 }
      }
    },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["pending", "active", "revoked", "expired"] }
  }
}
